<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Project -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>

    <!-- Metadata -->
    <PackageId>Snowyyd.AnalyzerConfig</PackageId>
    <Version>3.1.5</Version>
    <Authors>snowyyd</Authors>
    <Description>Snowyyd's SDK for .NET projects</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/snowyyd/analyzerconfig.git</RepositoryUrl>
    <DevelopmentDependency>true</DevelopmentDependency>

    <!-- Output -->
    <NoBuild>true</NoBuild>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>

    <!-- Misc -->
    <IsPackable>true</IsPackable>
    <ErrorReport>none</ErrorReport>

  </PropertyGroup>

  <ItemGroup>
    <None Include="$(SolutionDir)/Snowyyd.AnalyzerConfig.*" Pack="true" PackagePath="build" />
    <None Include="$(SolutionDir)/.editorconfig" Pack="true" PackagePath="build/Snowyyd.AnalyzerConfig.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
